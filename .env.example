# ============================================================
# Copy this file to .env and fill in your real API keys.
# ============================================================

# --- OpenRouter (LLM + Embeddings) ---
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Cohere (Reranker, optional) ---
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# --- Qdrant (Vector Database) ---
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=rag_docs

# --- LangSmith (observability, optional) ---
# Get key: https://smith.langchain.com/settings
# When LANGSMITH_TRACING=true, all LangChain operations (retrieval, generation,
# RAGAS judge calls) are traced to the LANGSMITH_PROJECT at smith.langchain.com.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=rag

# --- ragas telemetry ---
# ragas sends anonymous usage analytics by default; set true to opt out.
RAGAS_DO_NOT_TRACK=false

# --- Retrieval tuning ---
DENSE_TOP_K=20
RERANK_TOP_K=5

# --- App Settings ---
# OpenRouter model format: provider/model-name
# Examples:
#   openai/gpt-4o-mini           (cheap, fast)
#   openai/gpt-4o                (best quality)
#   anthropic/claude-3.5-sonnet  (alternative)
#   google/gemini-2.0-flash-001  (fast, cheap)
LLM_MODEL=openai/gpt-4o-mini
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TEMPERATURE=0.0
